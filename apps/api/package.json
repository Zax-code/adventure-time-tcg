{
  "name": "@adventure-time/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "abilities:translate-description": "tsx scripts/translate-ability-description.ts",
    "abilities:backfill-fr": "tsx scripts/backfill-ability-translations.ts",
    "abilities:retranslate-fr": "tsx scripts/retranslate-ability-descriptions-fr.ts",
    "migrate:pwa-users:audit": "tsx scripts/migrate-pwa-users.ts audit",
    "migrate:pwa-users:dry-run": "tsx scripts/migrate-pwa-users.ts migrate",
    "migrate:pwa-users:apply": "tsx scripts/migrate-pwa-users.ts migrate --apply",
    "migrate:pwa-users:verify": "tsx scripts/migrate-pwa-users.ts verify"
  },
  "dependencies": {
    "@adventure-time/db": "file:../../packages/db",
    "@adventure-time/game-engine": "file:../../packages/game-engine",
    "@adventure-time/shared": "file:../../packages/shared",
    "@fastify/multipart": "^9.4.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.1",
    "jose": "^6.1.0",
    "minio": "^8.0.6",
    "uuid": "^11.0.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
