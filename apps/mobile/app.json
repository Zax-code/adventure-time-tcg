{
  "expo": {
    "name": "Adventure Time TCG",
    "description": "Collect Adventure Time-inspired cards, open packs, complete daily quests, and battle friends.",
    "slug": "adventure-time-tcg",
    "scheme": "adventure-time",
    "version": "1.0.22",
    "owner": "zax-code",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "love.leaetzak.adventuretime",
      "icon": "./assets/ios-icon.png",
      "requireFullScreen": true,
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Adventure Time TCG needs local network access to connect to the development server on this Mac.",
        "NSBonjourServices": [
          "_expo._tcp",
          "_reactnative._tcp"
        ]
      }
    },
    "android": {
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "privacyPolicyUrl": "https://app.leaetzak.love/privacy",
      "eas": {
        "projectId": "bba73c43-35cf-4baf-885e-2126ec97cf3a"
      }
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-sharing",
      "expo-build-properties",
      "expo-router",
      "expo-splash-screen",
      "expo-background-task",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser"
    ]
  }
}
