{
  "expo": {
    "name": "Adventure Time Native",
    "slug": "adventure-time-native",
    "owner": "zax-code",
    "scheme": "adventure-time-native",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "love.leaetzak.adventuretimenative"
    },
    "android": {
      "package": "love.leaetzak.adventuretimenative"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
