{
  "expo": {
    "name": "Adventure Time",
    "slug": "adventure-time-tcg",
    "owner": "zax-code",
    "scheme": "adventure-time",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "love.leaetzak.adventuretime"
    },
    "android": {
      "package": "love.leaetzak.adventuretime"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bba73c43-35cf-4baf-885e-2126ec97cf3a"
      }
    }
  }
}
