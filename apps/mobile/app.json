{
  "expo": {
    "name": "Adventure Time",
    "slug": "adventure-time-tcg",
    "version": "0.1.2",
    "owner": "zax-code",
    "scheme": "adventure-time",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF4AA2",
      "imageWidth": 470
    },
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "love.leaetzak.adventuretime",
      "icon": "./assets/ios-icon.png"
    },
    "android": {
      "package": "love.leaetzak.adventuretime",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF4AA2"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bba73c43-35cf-4baf-885e-2126ec97cf3a"
      }
    }
  }
}
