<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <gradient
        android:angle="315"
        android:endColor="#FFFAD1"
        android:startColor="#E8FCF2" />
      <corners android:radius="28dp" />
    </shape>
  </item>

  <item
    android:gravity="top|right"
    android:right="-24dp"
    android:top="-26dp">
    <shape android:shape="oval">
      <size
        android:width="160dp"
        android:height="160dp" />
      <gradient
  android:centerColor="#112ED4BF"
  android:centerX="0.5"
  android:centerY="0.5"
  android:endColor="#002ED4BF"
  android:gradientRadius="112dp"
  android:startColor="#272ED4BF"
  android:type="radial" />
    </shape>
  </item>

  <item
    android:bottom="-32dp"
    android:gravity="bottom|left"
    android:left="-22dp">
    <shape android:shape="oval">
      <size
        android:width="128dp"
        android:height="128dp" />
      <gradient
  android:centerColor="#0FF9DB59"
  android:centerX="0.5"
  android:centerY="0.5"
  android:endColor="#00F9DB59"
  android:gradientRadius="90dp"
  android:startColor="#22F9DB59"
  android:type="radial" />
    </shape>
  </item>

  <item
    android:drawable="@drawable/step_quest_widget_sparkle"
    android:gravity="bottom|left"
    android:height="16dp"
    android:bottom="42dp"
    android:left="112dp"
    android:width="16dp" />
</layer-list>
