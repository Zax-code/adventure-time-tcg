<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <gradient
        android:angle="315"
        android:endColor="#FFFAD1"
        android:startColor="#E8FCF2" />
      <corners android:radius="28dp" />
    </shape>
  </item>

  <item
    android:gravity="top|right"
    android:right="-24dp"
    android:top="-26dp">
    <shape android:shape="oval">
      <size
        android:width="160dp"
        android:height="160dp" />
      <solid android:color="#472ED4BF" />
    </shape>
  </item>

  <item
    android:bottom="-32dp"
    android:gravity="bottom|left"
    android:left="-22dp">
    <shape android:shape="oval">
      <size
        android:width="128dp"
        android:height="128dp" />
      <solid android:color="#3DF9DB59" />
    </shape>
  </item>

  <item
    android:drawable="@drawable/step_quest_widget_sparkle"
    android:gravity="top|right"
    android:height="16dp"
    android:right="30dp"
    android:top="18dp"
    android:width="16dp" />
</layer-list>
