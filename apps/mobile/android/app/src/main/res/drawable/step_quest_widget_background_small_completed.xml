<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <gradient
        android:angle="315"
        android:endColor="#FFFAD1"
        android:startColor="#E8FCF2" />
      <corners android:radius="28dp" />
    </shape>
  </item>

  <item
    android:gravity="top|right"
    android:right="-18dp"
    android:top="-20dp">
    <shape android:shape="oval">
      <size
        android:width="130dp"
        android:height="130dp" />
      <solid android:color="#472ED4BF" />
    </shape>
  </item>

  <item
    android:bottom="-26dp"
    android:gravity="bottom|left"
    android:left="-18dp">
    <shape android:shape="oval">
      <size
        android:width="104dp"
        android:height="104dp" />
      <solid android:color="#3DF9DB59" />
    </shape>
  </item>

  <item
    android:drawable="@drawable/step_quest_widget_sparkle"
    android:gravity="top|right"
    android:height="14dp"
    android:right="26dp"
    android:top="16dp"
    android:width="14dp" />
</layer-list>
