<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <gradient
        android:angle="315"
        android:endColor="#F3F8FF"
        android:startColor="#EDF3FF" />
      <corners android:radius="28dp" />
    </shape>
  </item>

  <item
    android:gravity="top|right"
    android:right="-24dp"
    android:top="-26dp">
    <shape android:shape="oval">
      <size
        android:width="160dp"
        android:height="160dp" />
      <gradient
  android:centerColor="#11818CF8"
  android:centerX="0.5"
  android:centerY="0.5"
  android:endColor="#00818CF8"
  android:gradientRadius="112dp"
  android:startColor="#27818CF8"
  android:type="radial" />
    </shape>
  </item>

  <item
    android:bottom="-32dp"
    android:gravity="bottom|left"
    android:left="-22dp">
    <shape android:shape="oval">
      <size
        android:width="128dp"
        android:height="128dp" />
      <gradient
  android:centerColor="#0F67E8F9"
  android:centerX="0.5"
  android:centerY="0.5"
  android:endColor="#0067E8F9"
  android:gradientRadius="90dp"
  android:startColor="#2267E8F9"
  android:type="radial" />
    </shape>
  </item>

  <item
    android:drawable="@drawable/step_quest_widget_sparkle"
    android:gravity="top|right"
    android:height="16dp"
    android:right="30dp"
    android:top="18dp"
    android:width="16dp" />
</layer-list>
