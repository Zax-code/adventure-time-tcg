<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <gradient
        android:angle="315"
        android:endColor="#0F0105"
        android:startColor="#22050B" />
      <corners android:radius="28dp" />
    </shape>
  </item>

  <item
    android:gravity="top|right"
    android:right="-18dp"
    android:top="-20dp">
    <shape android:shape="oval">
      <size
        android:width="130dp"
        android:height="130dp" />
      <gradient
  android:centerColor="#11EF4444"
  android:centerX="0.5"
  android:centerY="0.5"
  android:endColor="#00EF4444"
  android:gradientRadius="92dp"
  android:startColor="#27EF4444"
  android:type="radial" />
    </shape>
  </item>

  <item
    android:bottom="-26dp"
    android:gravity="bottom|left"
    android:left="-18dp">
    <shape android:shape="oval">
      <size
        android:width="104dp"
        android:height="104dp" />
      <gradient
  android:centerColor="#0FF97316"
  android:centerX="0.5"
  android:centerY="0.5"
  android:endColor="#00F97316"
  android:gradientRadius="76dp"
  android:startColor="#22F97316"
  android:type="radial" />
    </shape>
  </item>

  <item
    android:drawable="@drawable/step_quest_widget_sparkle"
    android:gravity="top|right"
    android:height="14dp"
    android:right="26dp"
    android:top="16dp"
    android:width="14dp" />
</layer-list>
