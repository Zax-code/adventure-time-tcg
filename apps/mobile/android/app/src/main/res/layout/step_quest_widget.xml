<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/step_quest_widget_background_small"
  android:gravity="top"
  android:orientation="vertical"
  android:paddingStart="12dp"
  android:paddingTop="10dp"
  android:paddingEnd="12dp"
  android:paddingBottom="10dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/widget_badge"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/step_quest_widget_badge"
      android:fontFamily="sans-serif-medium"
      android:includeFontPadding="false"
      android:paddingStart="9dp"
      android:paddingTop="5dp"
      android:paddingEnd="9dp"
      android:paddingBottom="5dp"
      android:textColor="#4A3728"
      android:textSize="9sp"
      android:textStyle="bold" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="1dp"
      android:layout_weight="1" />

    <LinearLayout
      android:id="@+id/widget_reward_chip"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_widget_coin" />

      <TextView
        android:id="@+id/widget_reward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:textColor="#8A4A00"
        android:textSize="11sp" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_horizontal|center_vertical"
    android:orientation="vertical">

    <TextView
      android:id="@+id/widget_title"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:fontFamily="sans-serif-black"
      android:gravity="center"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:textColor="#4A3728"
      android:textSize="16sp" />

    <TextView
      android:id="@+id/widget_status_pill"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:background="@drawable/step_quest_widget_status_active"
      android:fontFamily="sans-serif-medium"
      android:includeFontPadding="false"
      android:paddingStart="8dp"
      android:paddingTop="4dp"
      android:paddingEnd="8dp"
      android:paddingBottom="4dp"
      android:textColor="#BE185D"
      android:textSize="10sp"
      android:textStyle="bold" />

    <ImageView
      android:id="@+id/widget_ring"
      android:layout_width="98dp"
      android:layout_height="98dp"
      android:layout_marginTop="6dp"
      android:contentDescription="@null" />

    <TextView
      android:id="@+id/widget_fallback_body"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:fontFamily="sans-serif-medium"
      android:gravity="center"
      android:includeFontPadding="false"
      android:maxLines="3"
      android:textColor="#6B5A47"
      android:textSize="11sp"
      android:visibility="gone" />

    <TextView
      android:id="@+id/widget_detail_label"
      android:layout_width="1dp"
      android:layout_height="1dp"
      android:visibility="gone" />

    <TextView
      android:id="@+id/widget_detail_body"
      android:layout_width="1dp"
      android:layout_height="1dp"
      android:visibility="gone" />
  </LinearLayout>
</LinearLayout>
