<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/step_quest_widget_background_medium"
  android:gravity="top"
  android:orientation="vertical"
  android:padding="12dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/widget_badge"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:fontFamily="sans-serif-medium"
      android:includeFontPadding="false"
      android:paddingStart="8dp"
      android:paddingTop="4dp"
      android:paddingEnd="8dp"
      android:paddingBottom="4dp"
      android:textColor="#4A3728"
      android:textSize="9sp"
      android:textStyle="bold" />

    <Space
      android:layout_width="0dp"
      android:layout_height="1dp"
      android:layout_weight="1" />

    <LinearLayout
      android:id="@+id/widget_reward_chip"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="2dp"
      android:paddingTop="2dp"
      android:paddingEnd="2dp"
      android:paddingBottom="2dp">

      <ImageView
        android:id="@+id/widget_reward_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_widget_coin" />

      <TextView
        android:id="@+id/widget_reward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:textColor="#894B00"
        android:textSize="11sp"
        android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>

  <TextView
    android:id="@+id/widget_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:ellipsize="end"
    android:fontFamily="sans-serif-black"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:textColor="#4A3728"
    android:textSize="16sp" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="10dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:gravity="top"
      android:orientation="vertical">

      <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#6B5A47"
        android:textSize="11sp" />

      <TextView
        android:id="@+id/widget_status_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/step_quest_widget_status_active"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:textColor="#BE185D"
        android:textSize="10sp"
        android:textStyle="bold" />

      <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:max="10000"
        android:progress="0"
        android:progressDrawable="@drawable/step_quest_widget_progress" />

      <TextView
        android:id="@+id/widget_progress_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:textColor="#4A3728"
        android:textSize="11sp"
        android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="78dp"
      android:layout_height="match_parent"
      android:gravity="center"
      android:orientation="vertical"
      android:padding="6dp">

      <TextView
        android:id="@+id/widget_metric_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:textColor="#DB2777"
        android:textSize="21sp" />

      <TextView
        android:id="@+id/widget_metric_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#7A6A56"
        android:textSize="9sp"
        android:textStyle="bold" />

      <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="6dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_widget_coin" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
