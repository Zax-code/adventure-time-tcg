<?xml version="1.0" encoding="utf-8"?>
<!-- Step quest widget, design board 05 "Row 2 - step quest widget". White shapes and
     icons are tinted at runtime from the theme tokens in StepQuestWidgetProvider.kt. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ImageView
    android:id="@+id/widget_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@null"
    android:scaleType="fitXY"
    android:src="@drawable/step_quest_widget_shape_background" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <FrameLayout
        android:id="@+id/widget_tile"
        android:layout_width="32dp"
        android:layout_height="32dp">

        <ImageView
          android:id="@+id/widget_tile_bg"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:contentDescription="@null"
          android:scaleType="fitXY"
          android:src="@drawable/step_quest_widget_shape_fill" />

        <ImageView
          android:id="@+id/widget_tile_border"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:contentDescription="@null"
          android:scaleType="fitXY"
          android:src="@drawable/step_quest_widget_shape_border" />

        <ImageView
          android:id="@+id/widget_tile_icon"
          android:layout_width="18dp"
          android:layout_height="18dp"
          android:layout_gravity="center"
          android:contentDescription="@null"
          android:src="@drawable/ic_step_quest_widget_footprints" />
      </FrameLayout>

      <TextView
        android:id="@+id/widget_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textSize="15sp" />

      <FrameLayout
        android:id="@+id/widget_reward_chip"
        android:layout_width="wrap_content"
        android:layout_height="28dp">

        <ImageView
          android:id="@+id/widget_reward_chip_bg"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:contentDescription="@null"
          android:scaleType="fitXY"
          android:src="@drawable/step_quest_widget_shape_fill" />

        <ImageView
          android:id="@+id/widget_reward_chip_border"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:contentDescription="@null"
          android:scaleType="fitXY"
          android:src="@drawable/step_quest_widget_shape_border" />

        <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="match_parent"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:paddingStart="12dp"
          android:paddingEnd="12dp">

          <ImageView
            android:id="@+id/widget_reward_chip_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_step_quest_widget_coins" />

          <TextView
            android:id="@+id/widget_reward_chip_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="12sp"
            android:textStyle="bold" />
        </LinearLayout>
      </FrameLayout>
    </LinearLayout>

    <View
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:minHeight="8dp" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="bottom"
      android:orientation="horizontal">

      <LinearLayout
        android:id="@+id/widget_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:id="@+id/widget_steps"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif-black"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:textSize="28sp" />

        <TextView
          android:id="@+id/widget_of_target"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:fontFamily="sans-serif-medium"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:textSize="12sp" />
      </LinearLayout>

      <FrameLayout
        android:id="@+id/widget_status_chip"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginStart="10dp">

        <ImageView
          android:id="@+id/widget_status_chip_bg"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:contentDescription="@null"
          android:scaleType="fitXY"
          android:src="@drawable/step_quest_widget_shape_fill" />

        <ImageView
          android:id="@+id/widget_status_chip_border"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:contentDescription="@null"
          android:scaleType="fitXY"
          android:src="@drawable/step_quest_widget_shape_border" />

        <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="match_parent"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:paddingStart="12dp"
          android:paddingEnd="12dp">

          <ImageView
            android:id="@+id/widget_status_chip_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_step_quest_widget_footprints" />

          <TextView
            android:id="@+id/widget_status_chip_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="12sp"
            android:textStyle="bold" />
        </LinearLayout>
      </FrameLayout>
    </LinearLayout>

    <LinearLayout
      android:id="@+id/widget_fallback"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:visibility="gone">

      <TextView
        android:id="@+id/widget_fallback_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/step_quest_widget_fallback_title"
        android:textSize="17sp" />

      <TextView
        android:id="@+id/widget_fallback_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="3"
        android:text="@string/step_quest_widget_fallback_body"
        android:textSize="12sp" />
    </LinearLayout>

    <View
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:minHeight="8dp" />

    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="8dp">

      <ImageView
        android:id="@+id/widget_bar_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/step_quest_widget_shape_fill" />

      <ImageView
        android:id="@+id/widget_bar_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/step_quest_widget_shape_border" />

      <ImageView
        android:id="@+id/widget_bar_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/step_quest_widget_bar_fill" />
    </FrameLayout>

    <TextView
      android:id="@+id/widget_footnote"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:ellipsize="end"
      android:fontFamily="sans-serif-medium"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:textSize="12sp" />
  </LinearLayout>
</FrameLayout>
