{
  "name": "@adventure-time/mobile",
  "version": "1.0.25",
  "private": true,
  "main": "./index.js",
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-orientation-locker"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "scripts": {
    "dev": "../../infra/scripts/expo-dev-client.sh",
    "dev:both": "../../infra/scripts/dev-mobile-both.sh",
    "android:local": "./scripts/run-android.sh",
    "ios:local": "./scripts/run-ios.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test:ui-regressions": "node --experimental-strip-types --test test/leaderboard-avatar-source.test.ts test/leaderboard-raw-result-format.test.ts test/mobile-ui-regressions.test.mjs test/perfect-timing-ui.test.mjs",
    "test:startup": "node --experimental-strip-types --test test/startup-recovery.test.ts",
    "build:android:dev": "eas build --platform android --profile development",
    "build:ios:dev": "eas build --platform ios --profile development",
    "build:ios:dev:simulator": "eas build --platform ios --profile development-simulator",
    "build:android:local": "node ./scripts/build-android-local.mjs",
    "build:ios:local": "node ./scripts/build-ios-local.mjs",
    "play:release-notes": "node ./scripts/set-play-release-notes.mjs",
    "release:android": "node ./scripts/release-android.mjs",
    "release:ios": "node ./scripts/release-ios.mjs",
    "test:quests": "node --experimental-strip-types --test test/quest-day-cutoff.test.ts test/quest-hub-model.test.ts test/quest-i18n-parity.test.ts test/quest-share-date.test.ts test/perfect-timing-model.test.ts test/perfect-timing-ui.test.mjs test/daily-numbers-result-layout.test.mjs test/daily-numbers-result-width.test.mjs"
  },
  "dependencies": {
    "@adventure-time/api-client": "file:../../packages/api-client",
    "@adventure-time/game-engine": "file:../../packages/game-engine",
    "@adventure-time/theme": "file:../../packages/theme",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/ui": "~57.0.11",
    "@kingstinct/react-native-healthkit": "^14.0.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native-vector-icons/ionicons": "^13.1.2",
    "@swmansion/react-native-bottom-sheet": "^0.12.0",
    "@tanstack/react-query": "^5.66.8",
    "expo": "~57.0.13",
    "expo-apple-authentication": "~57.0.1",
    "expo-auth-session": "~57.0.7",
    "expo-background-task": "~57.0.10",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.11",
    "expo-constants": "~57.0.11",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.12",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.10",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-notifications": "~57.0.11",
    "expo-router": "~57.0.13",
    "expo-secure-store": "~57.0.1",
    "expo-sensors": "~57.0.2",
    "expo-sharing": "~57.0.12",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-task-manager": "~57.0.10",
    "expo-web-browser": "~57.0.2",
    "nativewind": "^4.2.3",
    "phoenix": "^1.8.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-health-connect": "^3.5.3",
    "react-native-nitro-modules": "^0.35.9",
    "react-native-orientation-locker": "^1.7.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "connect": "^3.7.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  }
}
