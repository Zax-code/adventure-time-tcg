[Unit]
Description=Adventure Time Phoenix API
After=network-online.target container-adventure-time-tcg-postgres.service container-adventure-time-tcg-minio.service
Wants=network-online.target
Requires=container-adventure-time-tcg-postgres.service container-adventure-time-tcg-minio.service

[Service]
Type=simple
User=zax
Group=zax
WorkingDirectory=/home/zax/adventure-time-tcg/apps/phoenix
Environment=HOME=/home/zax
ExecStart=/bin/bash -lc 'set -a && source /home/zax/adventure-time-tcg/apps/phoenix/.env && export PORT=${PHX_PORT:-4200} && export MIX_ENV=prod && export PHX_SERVER=true && exec mix phx.server'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
