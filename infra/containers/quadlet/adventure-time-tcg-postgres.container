[Unit]
Description=Adventure Time TCG Postgres
After=network-online.target adventure-time-tcg-pod.service
Wants=adventure-time-tcg-pod.service
Requires=adventure-time-tcg-pod.service

[Container]
ContainerName=adventure-time-tcg-postgres
Image=docker.io/library/postgres:16-alpine
Pod=adventure-time-tcg.pod
Volume=/srv/adventure-time-tcg/postgres:/var/lib/postgresql/data:Z
Environment=POSTGRES_DB=adventure_time_tcg
Environment=POSTGRES_USER=postgres
Environment=POSTGRES_PASSWORD=postgres
Exec=postgres -c listen_addresses=127.0.0.1
HealthCmd=pg_isready -U postgres
HealthInterval=30s
HealthRetries=5
HealthStartPeriod=15s
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
