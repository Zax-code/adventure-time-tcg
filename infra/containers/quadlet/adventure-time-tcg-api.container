[Unit]
Description=Adventure Time TCG API
After=network-online.target adventure-time-tcg-pod.service adventure-time-tcg-postgres.service adventure-time-tcg-minio.service
Wants=adventure-time-tcg-pod.service
Requires=adventure-time-tcg-pod.service adventure-time-tcg-postgres.service adventure-time-tcg-minio.service

[Container]
ContainerName=adventure-time-tcg-api
Image=ghcr.io/zax-code/adventure-time-tcg-api:latest
Pull=never
Network=host
Environment=PHX_SERVER=true
Environment=PHX_IP=127.0.0.1
Environment=PHX_PORT=4200
EnvironmentFile=/home/zax/adventure-time-tcg-secrets/api.container.env
Volume=/home/zax/adventure-time-tcg-secrets/msmtprc:/etc/msmtprc:ro
User=app
NoNewPrivileges=true
Notify=healthy
HealthCmd=curl --fail --silent http://127.0.0.1:4200/ready >/dev/null || exit 1
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=30s
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
