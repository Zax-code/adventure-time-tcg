[Unit]
Description=Adventure Time TCG MinIO
After=network-online.target adventure-time-tcg-pod.service
Wants=adventure-time-tcg-pod.service
Requires=adventure-time-tcg-pod.service

[Container]
ContainerName=adventure-time-tcg-minio
# Community MinIO is no longer published. CVE-2025-62506 and CVE-2026-41145
# are fixed only in later or commercial builds; the service is loopback-only
# and the replacement is tracked in docs/operations (MinIO replacement).
Image=quay.io/minio/minio:RELEASE.2025-02-28T09-55-16Z
Pod=adventure-time-tcg.pod
Volume=/srv/adventure-time-tcg/minio:/data:Z
EnvironmentFile=/home/zax/adventure-time-tcg-secrets/minio.container.env
NoNewPrivileges=true
Exec=minio server /data --console-address :9001

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
