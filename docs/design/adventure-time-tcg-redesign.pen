        },
        {
          "type": "frame",
          "id": "JPYvm",
          "name": "Native Principle 2",
          "width": "fill_container",
          "fill": "#FFFFFF",
          "cornerRadius": 8,
          "stroke": "$native-line",
          "strokeWidth": 1,
          "layout": "vertical",
          "gap": 10,
          "padding": 16,
          "children": [
            {
              "type": "text",
              "id": "oq49W",
              "name": "Native Principle Label 2",
              "fill": "$native-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Principle 2",
              "lineHeight": 1.2,
              "fontFamily": "$font-body",
              "fontSize": 13,
              "fontWeight": "800"
            },
            {
              "type": "text",
              "id": "JRCYW",
              "name": "Native Principle Text 2",
              "fill": "$native-ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Protect one-handed use: keep primary actions above or within the thumb zone, account for the floating bottom tab bar, and preserve 44px targets.",
              "lineHeight": 1.24,
              "fontFamily": "$font-body",
              "fontSize": 18,
              "fontWeight": "800"
            }
          ]
        },
        {
          "type": "frame",
          "id": "q9xqym",
          "name": "Native Principle 3",
          "width": "fill_container",
          "fill": "#F1FFF9",
          "cornerRadius": 8,
          "stroke": "$native-line",
          "strokeWidth": 1,
          "layout": "vertical",
          "gap": 10,
          "padding": 16,
          "children": [
            {
              "type": "text",
              "id": "sF4IM",
              "name": "Native Principle Label 3",
              "fill": "$native-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Principle 3",
              "lineHeight": 1.2,
              "fontFamily": "$font-body",
              "fontSize": 13,
              "fontWeight": "800"
            },
            {
              "type": "text",
              "id": "PqJt9",
              "name": "Native Principle Text 3",
              "fill": "$native-ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Make card and economy decisions scannable: name, rarity, owned copies, dust balance, recycle value, craft cost, and gift eligibility need a predictable order.",
              "lineHeight": 1.24,
              "fontFamily": "$font-body",
              "fontSize": 18,
              "fontWeight": "800"
            }
          ]
        },
        {
          "type": "frame",
          "id": "LyDBf",
          "name": "Native Principle 4",
          "width": "fill_container",
          "fill": "#FFFFFF",
          "cornerRadius": 8,
          "stroke": "$native-line",
          "strokeWidth": 1,
          "layout": "vertical",
          "gap": 10,
          "padding": 16,
          "children": [
            {
              "type": "text",
              "id": "ugW14",
              "name": "Native Principle Label 4",
              "fill": "$native-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Principle 4",
              "lineHeight": 1.2,
              "fontFamily": "$font-body",
              "fontSize": 13,
              "fontWeight": "800"
            },
            {
              "type": "text",
              "id": "IbRjV",
              "name": "Native Principle Text 4",
              "fill": "$native-ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Keep Adventure Time warmth, but reduce all-pink ambiguity: color should support hierarchy, not be the only state signal.",
              "lineHeight": 1.24,
              "fontFamily": "$font-body",
              "fontSize": 18,
              "fontWeight": "800"
            }
          ]
        },
        {
          "type": "frame",
          "id": "m20Xg",
          "name": "Native Principle 5",
          "width": "fill_container",
          "fill": "#F1FFF9",
          "cornerRadius": 8,
          "stroke": "$native-line",
          "strokeWidth": 1,
          "layout": "vertical",
          "gap": 10,
          "padding": 16,
          "children": [
            {
              "type": "text",
              "id": "DUOuY",
              "name": "Native Principle Label 5",
              "fill": "$native-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Principle 5",
              "lineHeight": 1.2,
              "fontFamily": "$font-body",
              "fontSize": 13,
              "fontWeight": "800"
            },
            {
              "type": "text",
              "id": "aNQ6E",
              "name": "Native Principle Text 5",
              "fill": "$native-ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Respect native sheets and safe areas: route-backed sheets need visible handles, clear titles, and content that does not bury primary actions below the first viewport.",
              "lineHeight": 1.24,
              "fontFamily": "$font-body",
              "fontSize": 18,
              "fontWeight": "800"
            }
          ]
