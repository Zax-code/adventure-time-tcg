            {
              "type": "text",
              "id": "gTFBW",
              "name": "Native Principle Text 1",
              "fill": "$native-ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Lead with today’s playable native actions: daily reward, ready quest, ready pack, PvP readiness, and collection deltas.",
