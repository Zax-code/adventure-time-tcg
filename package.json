{
  "name": "adventure-time-tcg",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "cd apps/phoenix && /bin/bash -lc 'set -a && source .env && set +a && mix phx.server'",
    "dev:phoenix": "cd apps/phoenix && /bin/bash -lc 'set -a && source .env && set +a && mix phx.server'",
    "dev:api:container": "docker compose up api",
    "dev:stack": "docker compose up",
    "dev:mobile": "npm run dev -w @adventure-time/mobile",
    "dev:mobile:android": "npm run android:local -w @adventure-time/mobile",
    "dev:mobile:ios": "npm run ios:local -w @adventure-time/mobile",
    "dev:mobile:both": "npm run dev:both -w @adventure-time/mobile",
    "build:mobile:e2e:ios": "node ./apps/mobile/scripts/build-ios-e2e-local.mjs",
    "build:mobile:e2e:android": "node ./apps/mobile/scripts/build-android-e2e-local.mjs",
    "install:mobile:e2e:ios": "node ./apps/mobile/scripts/install-ios-e2e-local.mjs",
    "install:mobile:e2e:android": "./apps/mobile/scripts/install-android-e2e-local.sh",
    "build:mobile:dev:android": "npm run build:android:dev -w @adventure-time/mobile --",
    "build:mobile:dev:ios": "npm run build:ios:dev -w @adventure-time/mobile --",
    "build:mobile:dev:ios:simulator": "npm run build:ios:dev:simulator -w @adventure-time/mobile --",
    "build:mobile:local": "node ./scripts/build-mobile.mjs",
    "build:mobile:android:local": "npm run build:android:local -w @adventure-time/mobile --",
    "build:mobile:ios:local": "npm run build:ios:local -w @adventure-time/mobile --",
    "release:mobile": "node ./scripts/release-mobile.mjs",
    "release:mobile:android": "npm run release:android -w @adventure-time/mobile --",
    "release:mobile:ios": "npm run release:ios -w @adventure-time/mobile --",
    "greenlight:mobile": "./scripts/greenlight-mobile-preflight.sh",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "postinstall": "patch-package",
    "test:mobile:e2e:ios": "./scripts/maestro.sh test --platform ios .maestro/smoke.yaml",
    "test:mobile:e2e:android": "./scripts/maestro.sh test --platform android .maestro/smoke.yaml",
    "test:mobile:e2e:pvp:ios": "./scripts/maestro.sh test --platform ios .maestro/pvp-smoke.yaml",
    "test:mobile:e2e:pvp:android": "./scripts/maestro.sh test --platform android .maestro/pvp-smoke.yaml",
    "test:mobile:e2e:pvp:head-to-head:ios": "./scripts/maestro-pvp-head-to-head.sh --platform ios",
    "test:mobile:e2e:pvp:head-to-head:android": "./scripts/maestro-pvp-head-to-head.sh --platform android",
    "db:generate": "npm run db:generate -w @adventure-time/db",
    "db:migrate": "npm run db:migrate -w @adventure-time/db",
    "doctor": "react-doctor"
  },
  "dependencies": {
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "expo-router": "~56.2.13",
    "patch-package": "^8.0.1",
    "react-doctor": "^0.6.0"
  },
  "overrides": {
    "@expo/fingerprint": "0.19.6",
    "@expo/log-box": "56.0.14",
    "nativewind": "4.2.3",
    "expo": "56.0.14",
    "expo-asset": "56.0.18",
    "expo-constants": "56.0.20",
    "expo-file-system": "56.0.8",
    "expo-font": "56.0.7",
    "expo-modules-core": "56.0.19",
    "expo-modules-jsi": "56.0.11",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-css-interop": "0.2.3",
    "react-native-gesture-handler": "2.31.2",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-worklets": "0.8.3"
  }
}
